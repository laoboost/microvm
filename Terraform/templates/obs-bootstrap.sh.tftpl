#!/bin/bash
# obs-bootstrap.sh — provision Prometheus + Grafana on a dedicated obs EC2 instance.
# Rendered by Terraform/obs.tf; not for manual execution.
set -euo pipefail
exec > /var/log/aerolvm-obs-bootstrap.log 2>&1

export DEBIAN_FRONTEND=noninteractive

echo "=== aerolvm obs bootstrap starting ==="

# Persistent Prometheus TSDB on a dedicated EBS volume (Arch-5).
PROM_MOUNT=/var/lib/prometheus
mkdir -p "$PROM_MOUNT"

# Wait for the attached data volume (Terraform attaches /dev/sdf → NVMe on Nitro).
DATA_DEV=""
for _ in $(seq 1 60); do
  for candidate in /dev/sdf /dev/xvdf /dev/nvme1n1; do
    if [[ -b "$candidate" ]]; then
      DATA_DEV="$candidate"
      break 2
    fi
  done
  sleep 2
done
if [[ -z "$DATA_DEV" ]]; then
  echo "ERROR: prometheus data volume not found" >&2
  exit 1
fi

if ! blkid "$DATA_DEV" >/dev/null 2>&1; then
  mkfs.ext4 -F "$DATA_DEV"
fi
grep -q "$PROM_MOUNT" /etc/fstab || echo "$DATA_DEV $PROM_MOUNT ext4 defaults,nofail 0 2" >> /etc/fstab
mountpoint -q "$PROM_MOUNT" || mount "$PROM_MOUNT"
chown -R 65534:65534 "$PROM_MOUNT"

# Docker Engine + the v2 `compose` plugin. The stock Ubuntu (jammy) archive
# ships `docker.io` but NOT `docker-compose-plugin` — that package lives only in
# Docker's own apt repo — so `docker compose` (used below) would fail and, under
# `set -euo pipefail`, abort the whole bootstrap. Add Docker's repo first.
# (The sandboxd fleet defaults to containerd; the obs box is standalone infra
# and uses Docker Compose purely to declare the 4-service monitoring stack.)
apt-get update -y
apt-get install -y ca-certificates curl gnupg jq
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
. /etc/os-release
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $${VERSION_CODENAME} stable" > /etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker

OBS_ROOT=/opt/aerolvm-obs
# 0700 on OBS_ROOT: prometheus.yml embeds the scrape bearer token (PAT) and
# .env holds the Grafana admin password. install -d only modes the leaf it
# creates, so OBS_ROOT itself is forced explicitly.
install -d -m 0700 "$OBS_ROOT"
# Grafana bind-mounts these directories into the grafana container (uid 472),
# which must be able to traverse and read them. 0700 root:root left grafana
# with no dashboards/datasources, and restart: unless-stopped turned that into
# a silent crash loop. They contain no secrets, so 0755 dirs / 0644 files.
# (prometheus.yml below is different — it carries the PAT and is owned 65534.)
install -d -m 0755 "$OBS_ROOT/grafana/dashboards" "$OBS_ROOT/grafana/provisioning/datasources" "$OBS_ROOT/grafana/provisioning/dashboards"
chmod 0700 "$OBS_ROOT"
chmod 0755 "$OBS_ROOT/grafana" "$OBS_ROOT/grafana/provisioning"

cat > "$OBS_ROOT/docker-compose.yml" <<'COMPOSE_EOF'
${docker_compose}
COMPOSE_EOF

# prometheus.yml carries the bearer PAT for the sandboxd scrape targets. The
# prometheus container (uid 65534) bind-mounts it read-only at
# /etc/prometheus/prometheus.yml, so it must be owned by 65534 and readable by
# it — 0600 root:root made Prometheus unable to read its own config, which with
# restart: unless-stopped became a silent crash loop. 0400 (not 0600) also keeps
# every other uid out.
( umask 077; echo '${prometheus_yml_b64}' | base64 -d > "$OBS_ROOT/prometheus.yml.tmp" )
install -o 65534 -g 65534 -m 0400 "$OBS_ROOT/prometheus.yml.tmp" "$OBS_ROOT/prometheus.yml"
rm -f "$OBS_ROOT/prometheus.yml.tmp"

cat > "$OBS_ROOT/grafana/provisioning/datasources/prometheus.yml" <<'DS_EOF'
${grafana_datasource_yml}
DS_EOF

cat > "$OBS_ROOT/grafana/provisioning/dashboards/dashboards.yml" <<'DBPROV_EOF'
${grafana_dashboards_yml}
DBPROV_EOF
chmod 0644 "$OBS_ROOT/grafana/provisioning/datasources/prometheus.yml" \
           "$OBS_ROOT/grafana/provisioning/dashboards/dashboards.yml"

%{ for name, content in dashboard_files ~}
cat > "$OBS_ROOT/grafana/dashboards/${name}" <<'__AEROLVM_DASH_EOF__'
${content}
__AEROLVM_DASH_EOF__
chmod 0644 "$OBS_ROOT/grafana/dashboards/${name}"
%{ endfor ~}

cat > "$OBS_ROOT/.env" <<EOF
GRAFANA_ADMIN_PASSWORD=${grafana_admin_password}
EOF
chmod 600 "$OBS_ROOT/.env"

cd "$OBS_ROOT"
docker compose --env-file .env up -d

echo "=== aerolvm obs bootstrap complete ==="
